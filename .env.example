# Copiar a .env.local y completar. .env* está en .gitignore: NUNCA commitear
# el archivo con valores reales.

# ---------------------------------------------------------------- Neon
# Región São Paulo (sa-east-1): es la más cercana a Montevideo. La latencia
# servidor→DB se paga en cada request porque la sesión se valida contra la base.
# Verificá que diga `-pooler` en el host: es el endpoint con pool de Neon.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------- Google OAuth
# console.cloud.google.com → APIs & Services → Credentials
#   → Create Credentials → OAuth client ID → Web application
#
# En "Authorized redirect URIs" va EXACTAMENTE la misma URL que
# GOOGLE_REDIRECT_URI. Google hace match exacto: una barra de más y falla.
#   dev:  http://localhost:3000/api/auth/google/callback
#   prod: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------- correo
# Resend (resend.com). El dominio del remitente tiene que estar verificado con
# sus registros DNS: sin eso los mails caen en spam o directamente rebotan.
# Para probar sin dominio propio, Resend permite usar onboarding@resend.dev.
#
# Si faltan estas dos, en desarrollo los correos se imprimen en la terminal.
# En producción la app se niega a arrancar el envío: quedarse sin correo es una
# falla silenciosa —nadie verifica su cuenta ni recupera la contraseña—.
RESEND_API_KEY=""
EMAIL_FROM="Anima <hola@tu-dominio>"

# --------------------------------------------------------------- app
# URL pública, sin barra final. Con esto se arman los links de los correos.
#
# NO se deriva del header Host del request: ese header lo controla quien manda
# la petición, y un `Host: sitio-atacante.com` haría que el link para cambiar
# la contraseña apunte al atacante.
APP_URL="http://localhost:3000"

# --------------------------------------------------------------- cron
# Token del endpoint de limpieza (/api/cron/limpieza). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
